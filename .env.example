NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://ted:ted@localhost:5432/ted_backend?schema=public"
# En local (Docker Compose, sin pooler) puede ser igual a DATABASE_URL. En
# Supabase, DATABASE_URL apunta al connection pooler (puerto 6543, runtime)
# y DIRECT_URL a la conexión directa (puerto 5432, solo la usan las
# migraciones -- ver prisma.config.ts).
DIRECT_URL="postgresql://ted:ted@localhost:5432/ted_backend?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="reemplaza-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres"
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN="http://localhost:5173"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TEDxUCB <no-reply@tedxucb.local>"
QR_TOKEN_SECRET="otra-cadena-aleatoria-distinta-de-jwt-secret-de-al-menos-32-caracteres"

