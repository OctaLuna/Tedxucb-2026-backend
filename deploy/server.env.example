# Safe template for the self-hosted Compose stack. Replace every REPLACE_* value.
# Never put real credentials in this file; copy it to .env on the server.

# Image versions produced by deploy/package-images.ps1
IMAGE_TAG=release-YYYYMMDD
# Leave empty to inherit IMAGE_TAG; these allow independent release tags.
BACKEND_IMAGE_TAG=
INNOVATION_IMAGE_TAG=
# Optional TEDx-only override.
TEDX_IMAGE_TAG=

# Generate unique random values for this installation; do not reuse JWT/QR/avatar keys.
DB_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
QR_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AVATAR_BRIDGE_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_TTL_DAYS=30

# Public Web OAuth client ID; the same ID must be configured in both frontends.
GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=

# Public frontend origins and invitation destinations.
CORS_ORIGIN=https://tedxucb.sis-ucb.site,https://semana-fcef.sis-ucb.site
PUBLIC_FRONTEND_URL_TEDX=https://tedxucb.sis-ucb.site
PUBLIC_FRONTEND_URL_INNOVATION_WEEK=https://semana-fcef.sis-ucb.site

# Configure these when the external SMTP provider is ready. Port 465 uses implicit TLS.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=TEDxUCB <REPLACE_WITH_VERIFIED_SENDER_EMAIL>
