generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Nota de diseño: se intentó citext (Unsupported("citext")) para email
// insensible a mayúsculas, pero Prisma EXCLUYE por completo los campos
// Unsupported de su API tipada (create/findUnique/where no pueden tocarlos
// -- confirmado inspeccionando el cliente generado, no solo @unique falla).
// Se usa TEXT normal + CHECK (email = lower(email)) + UNIQUE: el motor
// rechaza cualquier fila que no llegue ya en minúsculas, y la app normaliza
// siempre antes de escribir/consultar (src/common/utils/normalize-email.util.ts).
model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  fullName           String   @map("full_name")
  nickname           String?
  nicknameKey        String?  @unique @map("nickname_key")
  status             String   @default("PENDING")
  registrationSource String   @map("registration_source")
  createdById        String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz

  createdBy                  User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers               User[]               @relation("UserCreatedBy")
  roles                      UserRole[]           @relation("UserRoles")
  identities                 UserIdentity[]
  grantedRoles               UserRole[]           @relation("RoleGrantedBy")
  authTokens                 AuthToken[]          @relation("AuthTokenUser")
  createdTokens              AuthToken[]          @relation("AuthTokenCreatedBy")
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  studentProfile             StudentProfile?
  resolvedCorrectionRequests CorrectionRequest[]  @relation("CorrectionRequestResolvedBy")
  updatedEvents              Event[]
  updatedContentBlocks       ContentBlock[]
  createdSpeakers            Speaker[]
  createdProgramItems        EventProgramItem[]   @relation("EventProgramCreatedBy")
  createdLiveActivities      EventLiveActivity[]  @relation("EventLiveActivityCreatedBy")
  updatedLiveActivities      EventLiveActivity[]  @relation("EventLiveActivityUpdatedBy")
  reviewedApplications       SpeakerApplication[]
  createdActivities          Activity[]           @relation("ActivityCreatedBy")
  activityStaffAssignments   ActivityStaff[]      @relation("ActivityStaffUser")
  assignedActivityStaff      ActivityStaff[]      @relation("ActivityStaffAssignedBy")
  validatedAttendances       Attendance[]         @relation("AttendanceValidatedBy")
  createdPointTransactions   PointTransaction[]   @relation("PointTransactionCreatedBy")
  executedSelectionRuns      SelectionRun[]       @relation("SelectionRunExecutedBy")
  revertedSelectionRuns      SelectionRun[]       @relation("SelectionRunRevertedBy")
  assignedSelections         Selection[]          @relation("SelectionAssignedBy")
  validatedSelectionEntries  Selection[]          @relation("SelectionEntryValidatedBy")
  revokedSelections          Selection[]          @relation("SelectionRevokedBy")

  @@map("users")
}

model UserIdentity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  provider      String
  subject       String
  verifiedEmail String   @map("verified_email")
  hostedDomain  String?  @map("hosted_domain")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("user_identities")
}

model ExternalEmailProof {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject    String
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([subject, email])
  @@map("external_email_proofs")
}

model IdentityInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  eventId    String    @map("event_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([eventId, email])
  @@map("identity_invitations")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        String
  grantedById String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model AuthToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  tokenHash   String    @unique @map("token_hash")
  newEmail    String?   @map("new_email")
  createdById String?   @map("created_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User  @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AuthTokenCreatedBy", fields: [createdById], references: [id])

  @@map("auth_tokens")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  replacedById String?   @unique @map("replaced_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenChain")

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  careers Career[]

  @@map("faculties")
}

model Career {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  faculty         Faculty          @relation(fields: [facultyId], references: [id])
  studentProfiles StudentProfile[]

  @@unique([facultyId, name])
  @@map("careers")
}

// 1:1 real con User: la propia FK es la PK (mismo patrón que ya usa 003 al
// referenciar student_profiles(user_id)).
model StudentProfile {
  userId             String   @id @map("user_id") @db.Uuid
  studentCode        String   @unique @map("student_code")
  careerId           String   @map("career_id") @db.Uuid
  academicPeriod     String   @map("academic_period")
  phone              String
  avatarUrl          String?  @map("avatar_url")
  idDocumentUrl      String?  @map("id_document_url")
  bio                String?
  interests          String[]
  accessibilityNeeds String?  @map("accessibility_needs")
  professionalLink   String?  @map("professional_link")
  // Caché derivada del libro mayor (Artículo IV) -- nunca fuente de verdad,
  // nunca escrita fuera de LedgerService. Reconstruible sumando
  // point_transactions en cualquier momento (ver points-cli reconcile).
  totalPoints        Int      @default(0) @map("total_points")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user               User                 @relation(fields: [userId], references: [id])
  career             Career               @relation(fields: [careerId], references: [id])
  consentAcceptances ConsentAcceptance[]
  correctionRequests CorrectionRequest[]
  attendances        Attendance[]
  pointTransactions  PointTransaction[]
  eventPoints        EventStudentPoints[]
  selections         Selection[]

  @@index([totalPoints(sort: Desc)])
  @@map("student_profiles")
}

// El texto es configurable por el admin (RF-128) -- todavía no existe un
// texto legal aprobado por la universidad, así que no puede ser fijo en el
// código. Solo una versión activa a la vez (índice único parcial en la
// migración).
model ConsentVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     String   @unique
  body        String
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  acceptances ConsentAcceptance[]

  @@map("consent_versions")
}

model ConsentAcceptance {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  consentVersionId String   @map("consent_version_id") @db.Uuid
  acceptedAt       DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  student        StudentProfile @relation(fields: [studentId], references: [userId])
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id])

  @@unique([studentId, consentVersionId])
  @@map("consent_acceptances")
}

// No estaba en data-model.md de 001-a (vacío ahí) -- lo exige el contrato
// usuarios-y-roles.md (POST /me/correction-requests, GET/POST resolve).
// Diseñado ahora, documentado como desvío en docs/progress.md.
model CorrectionRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  field          String
  newValue       String    @map("new_value")
  reason         String
  status         String    @default("PENDING")
  resolvedById   String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  student    StudentProfile @relation(fields: [studentId], references: [userId])
  resolvedBy User?          @relation("CorrectionRequestResolvedBy", fields: [resolvedById], references: [id])

  @@map("correction_requests")
}

// Singleton operativo: solo una fila PUBLISHED a la vez (índice único
// parcial en la migración, one_published_event). Sin historial de
// ediciones a propósito -- el spec solo pide editar el evento actual, no
// gestionar varias ediciones (Artículo VII, ver plan.md de 002).
model Event {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String?  @unique
  name            String
  tagline         String?
  startsAt        DateTime @map("starts_at") @db.Timestamptz
  venue           String?
  capacity        Int?
  // Desglose del aforo total -- cuántos de esos lugares se disputan por
  // ranking de puntos (004, RF-401). El resto (capacity - studentCapacity)
  // es de asignación manual (RF-420).
  studentCapacity Int?     @map("student_capacity")
  imageUrl        String?  @map("image_url")
  status          String   @default("DRAFT")
  updatedById     String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  updatedBy                  User?                            @relation(fields: [updatedById], references: [id])
  selectionRuns              SelectionRun[]
  emailAccess                EventEmailAccess[]
  identityInvitations        IdentityInvitation[]
  contentBlocks              ContentBlock[]
  speakers                   Speaker[]
  speakerApplications        SpeakerApplication[]
  activityCategories         ActivityCategory[]
  activities                 Activity[]
  pointTransactionOwnerships PointTransactionEventOwnership[]
  eventStudentPoints         EventStudentPoints[]
  selections                 Selection[]
  programItems               EventProgramItem[]
  liveSettings               EventLiveSettings?
  liveActivities             EventLiveActivity[]

  @@map("events")
}

model EventEmailAccess {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized String    @map("email_normalized")
  eventId         String    @map("event_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([emailNormalized, eventId])
  @@index([eventId, emailNormalized])
  @@map("event_email_access")
}

// Clave -> texto editable por el admin sin desplegar código (RF-203). Sin
// versionado ni estado de publicación -- no hay aquí el requisito legal que
// justifica el versionado de ConsentVersion (ver plan.md de 002).
model ContentBlock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  key         String
  title       String?
  body        String
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  event     Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@unique([eventId, key])
  @@index([eventId, updatedAt(sort: Desc)])
  @@map("content_blocks")
}

// Ficha pública del expositor (RF-206 a RF-209, RF-217). Sin DELETE -- se
// despublica (status: DRAFT), nunca se borra (data-model.md §3 de 002).
model Speaker {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  fullName     String   @map("full_name")
  headline     String?
  bio          String?
  talkTitle    String?  @map("talk_title")
  photoUrl     String?  @map("photo_url")
  photoAltText String?  @map("photo_alt_text")
  displayOrder Int      @default(0) @map("display_order")
  status       String   @default("DRAFT")
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation(fields: [createdById], references: [id])
  application  SpeakerApplication?
  programItems EventProgramItem[]

  @@unique([id, eventId])
  @@index([eventId, status, displayOrder])
  @@map("speakers")
}

model EventProgramItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  speakerId    String?  @map("speaker_id") @db.Uuid
  createdById  String?  @map("created_by") @db.Uuid
  title        String
  description  String?
  type         String   @default("TALK")
  startsAt     DateTime @map("starts_at") @db.Timestamptz
  endsAt       DateTime @map("ends_at") @db.Timestamptz
  displayOrder Int      @default(0) @map("display_order")
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  speaker        Speaker?            @relation(fields: [speakerId, eventId], references: [id, eventId], onDelete: Restrict)
  createdBy      User?               @relation("EventProgramCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  liveActivities EventLiveActivity[]

  @@unique([id, eventId])
  @@index([eventId, status, startsAt])
  @@index([eventId, displayOrder, startsAt])
  @@map("event_program_items")
}

model EventLiveSettings {
  eventId          String   @id @map("event_id") @db.Uuid
  enabled          Boolean  @default(true)
  manualActivityId String?  @map("manual_activity_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  manualActivity EventLiveActivity? @relation("EventLiveManualActivity", fields: [manualActivityId, eventId], references: [id, eventId], onDelete: Restrict)

  @@map("event_live_settings")
}

model EventLiveActivity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  agendaSlotId   String?  @map("agenda_slot_id") @db.Uuid
  createdById    String   @map("created_by") @db.Uuid
  updatedById    String   @map("updated_by") @db.Uuid
  title          String
  description    String?
  startsAt       DateTime @map("starts_at") @db.Timestamptz
  endsAt         DateTime @map("ends_at") @db.Timestamptz
  activationMode String   @default("schedule") @map("activation_mode")
  status         String   @default("DRAFT")
  quizEnabled    Boolean  @default(false) @map("quiz_enabled")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event              Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  agendaSlot         EventProgramItem?       @relation(fields: [agendaSlotId, eventId], references: [id, eventId], onDelete: Restrict)
  createdBy          User                    @relation("EventLiveActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User                    @relation("EventLiveActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  manualSelectionFor EventLiveSettings[]     @relation("EventLiveManualActivity")
  questions          EventLiveQuizQuestion[]
  media              EventLiveMedia[]

  @@unique([id, eventId])
  @@index([eventId, status, startsAt])
  @@index([eventId, displayOrder, startsAt])
  @@map("event_live_activities")
}

model EventLiveQuizQuestion {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String  @map("event_id") @db.Uuid
  activityId       String  @map("activity_id") @db.Uuid
  correctOptionId  String? @map("correct_option_id") @db.Uuid
  prompt           String
  timeLimitSeconds Int     @map("time_limit_seconds")
  points           Int     @default(0)
  displayOrder     Int     @default(0) @map("display_order")

  activity      EventLiveActivity     @relation(fields: [activityId, eventId], references: [id, eventId], onDelete: Cascade)
  options       EventLiveQuizOption[] @relation("LiveQuizQuestionOptions")
  correctOption EventLiveQuizOption?  @relation("LiveQuizCorrectOption", fields: [correctOptionId, id], references: [id, questionId], onDelete: Restrict)

  @@unique([id, eventId])
  @@unique([correctOptionId, id])
  @@index([activityId, displayOrder])
  @@map("event_live_quiz_questions")
}

model EventLiveQuizOption {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  text       String

  question   EventLiveQuizQuestion  @relation("LiveQuizQuestionOptions", fields: [questionId, eventId], references: [id, eventId], onDelete: Cascade)
  correctFor EventLiveQuizQuestion? @relation("LiveQuizCorrectOption")

  @@unique([id, questionId])
  @@index([questionId])
  @@map("event_live_quiz_options")
}

model EventLiveMedia {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String  @map("event_id") @db.Uuid
  activityId   String  @map("activity_id") @db.Uuid
  name         String
  kind         String
  url          String
  coverUrl     String? @map("cover_url")
  displayOrder Int     @default(0) @map("display_order")

  activity EventLiveActivity @relation(fields: [activityId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([activityId, displayOrder])
  @@map("event_live_media")
}

// Postulación pública (RF-210 a RF-215) -- máquina de estados propia, ver
// applications.service.ts. Sin created_by: la envía el público, no un
// usuario autenticado.
model SpeakerApplication {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  fullName           String    @map("full_name")
  email              String
  affiliation        String
  expertiseArea      String    @map("expertise_area")
  ideaTitle          String    @map("idea_title")
  ideaSummary        String    @map("idea_summary")
  evidenceBasis      String    @map("evidence_basis")
  applicability      String
  status             String    @default("PENDING")
  internalNotes      String?   @map("internal_notes")
  reviewedById       String?   @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  convertedSpeakerId String?   @unique @map("converted_speaker_id") @db.Uuid
  ipAddress          String?   @map("ip_address") @db.Inet
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event            Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewedBy       User?    @relation(fields: [reviewedById], references: [id])
  convertedSpeaker Speaker? @relation(fields: [convertedSpeakerId], references: [id])

  @@index([eventId, status, createdAt(sort: Desc)])
  @@map("speaker_applications")
}

// ---------------------------------------------------------------------
// 003-motor-de-puntos -- módulo `activities`. Sin PointClaim: el canal de
// reclamos se eliminó (ADR-008). Sin `capacity` en Activity: las
// actividades no limitan asistentes (confirmado 2026-09-02, ver
// data-model.md de 003).
// ---------------------------------------------------------------------

model ActivityCategory {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String  @map("event_id") @db.Uuid
  name            String
  color           String?
  suggestedPoints Int?    @map("suggested_points")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  activities Activity[]

  @@unique([id, eventId])
  @@unique([eventId, name])
  @@index([eventId])
  @@map("activity_categories")
}

// Sin campo de cupo: las actividades no limitan asistentes. Lo único que
// varía por actividad es cuánto otorga, nunca cuánta gente admite.
model Activity {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId               String   @map("event_id") @db.Uuid
  categoryId            String?  @map("category_id") @db.Uuid
  title                 String
  description           String?
  location              String?
  pointsValue           Int      @map("points_value")
  startsAt              DateTime @map("starts_at") @db.Timestamptz
  endsAt                DateTime @map("ends_at") @db.Timestamptz
  checkinOpensAt        DateTime @map("checkin_opens_at") @db.Timestamptz
  checkinClosesAt       DateTime @map("checkin_closes_at") @db.Timestamptz
  allowMultipleCheckins Boolean  @default(false) @map("allow_multiple_checkins")
  status                String   @default("DRAFT")
  createdById           String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  category          ActivityCategory?  @relation(fields: [categoryId, eventId], references: [id, eventId])
  createdBy         User               @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  staff             ActivityStaff[]
  attendances       Attendance[]
  pointTransactions PointTransaction[]

  @@index([status, startsAt(sort: Desc)])
  @@index([eventId, status, startsAt(sort: Desc)])
  @@map("activities")
}

// Lo que consulta ActivityStaffGuard en cada check-in -- RF-305, Artículo V
// (no hay staff con acceso global, solo asignación explícita).
model ActivityStaff {
  activityId   String   @map("activity_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation("ActivityStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("ActivityStaffAssignedBy", fields: [assignedById], references: [id])

  @@id([activityId, userId])
  @@map("activity_staff")
}

model Attendance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId      String   @map("activity_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  method          String
  status          String   @default("APPROVED")
  // Copia de activities.allow_multiple_checkins al momento de insertar, no
  // una referencia en vivo -- un índice único parcial no puede consultar
  // otra tabla en su predicado (ver data-model.md §3 de 003).
  multipleAllowed Boolean  @default(false) @map("multiple_allowed")
  validatedById   String?  @map("validated_by") @db.Uuid
  note            String?
  deviceHash      String?  @map("device_hash")
  ipAddress       String?  @map("ip_address") @db.Inet
  checkedInAt     DateTime @default(now()) @map("checked_in_at") @db.Timestamptz

  activity         Activity          @relation(fields: [activityId], references: [id])
  student          StudentProfile    @relation(fields: [studentId], references: [userId])
  validatedBy      User?             @relation("AttendanceValidatedBy", fields: [validatedById], references: [id])
  pointTransaction PointTransaction?

  @@index([studentId, checkedInAt(sort: Desc)])
  @@index([deviceHash, checkedInAt(sort: Desc)])
  @@map("attendances")
}

// Libro mayor -- Artículo IV. Tabla de solo inserción: el trigger
// forbid_ledger_mutation (migración) rechaza UPDATE/DELETE. Nunca se
// escribe fuera de LedgerService (src/common/ledger/).
model PointTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  points         Int
  type           String
  activityId     String?  @map("activity_id") @db.Uuid
  attendanceId   String?  @unique @map("attendance_id") @db.Uuid
  reversesId     String?  @unique @map("reverses_id") @db.Uuid
  reason         String?
  createdById    String?  @map("created_by") @db.Uuid
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  student        StudentProfile                  @relation(fields: [studentId], references: [userId])
  activity       Activity?                       @relation(fields: [activityId], references: [id])
  eventOwnership PointTransactionEventOwnership?
  attendance     Attendance?                     @relation(fields: [attendanceId], references: [id])
  reverses       PointTransaction?               @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy     PointTransaction?               @relation("Reversal")
  createdBy      User?                           @relation("PointTransactionCreatedBy", fields: [createdById], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@index([activityId])
  @@map("point_transactions")
}

// El ledger de puntos es append-only. Su pertenencia al evento vive en una
// tabla lateral para poder asignar recursos historicos sin UPDATE al ledger.
model PointTransactionEventOwnership {
  pointTransactionId String   @id @map("point_transaction_id") @db.Uuid
  eventId            String   @map("event_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  pointTransaction PointTransaction @relation(fields: [pointTransactionId], references: [id], onDelete: Restrict)
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, pointTransactionId])
  @@map("point_transaction_event_ownership")
}

// Reconstruible por evento desde el ledger inmutable; se actualiza en el
// mismo INSERT que asigna ownership, no desde el cliente.
model EventStudentPoints {
  eventId     String   @map("event_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  totalPoints Int      @default(0) @map("total_points")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Restrict)

  @@id([eventId, studentId])
  @@index([eventId, totalPoints(sort: Desc)])
  @@map("event_student_points")
}

// ---------------------------------------------------------------------
// 004-seleccion-de-cupos -- módulo `selection`. Tras ADR-009: sin máquina
// de estados de invitación, sin lista de espera -- una persona está
// seleccionada o no lo está (ver data-model.md de 004).
// ---------------------------------------------------------------------

model SelectionRun {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                 String    @map("event_id") @db.Uuid
  executedById            String    @map("executed_by") @db.Uuid
  studentCapacitySnapshot Int       @map("student_capacity_snapshot")
  executedAt              DateTime  @default(now()) @map("executed_at") @db.Timestamptz
  revertedById            String?   @map("reverted_by") @db.Uuid
  revertedAt              DateTime? @map("reverted_at") @db.Timestamptz
  revertReason            String?   @map("revert_reason")

  event      Event       @relation(fields: [eventId], references: [id])
  executedBy User        @relation("SelectionRunExecutedBy", fields: [executedById], references: [id])
  revertedBy User?       @relation("SelectionRunRevertedBy", fields: [revertedById], references: [id])
  selections Selection[]

  @@unique([id, eventId])
  @@map("selection_runs")
}

// source: 'RANKING' (por ranking, siempre con runId) | 'MANUAL' (RF-420 o
// cubrir a mano un lugar liberado, ADR-009 los trata como la misma
// operación). Entrada (RF-416/417) en la misma fila, en claro -- ver la
// nota de entryCode más abajo, corregido 2026-09-03.
model Selection {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String    @default(dbgenerated("legacy_default_event_id()")) @map("event_id") @db.Uuid
  runId              String?   @map("run_id") @db.Uuid
  source             String
  studentId          String?   @map("student_id") @db.Uuid
  audienceType       String    @default("ESTUDIANTE") @map("audience_type")
  fullName           String?   @map("full_name")
  email              String?
  pointsAtSelection  Int?      @map("points_at_selection")
  rankAtSelection    Int?      @map("rank_at_selection")
  assignedById       String?   @map("assigned_by") @db.Uuid
  reason             String?
  // En claro, NO hasheado -- a diferencia de auth_tokens.token_hash:
  // Historia 2 escenario 2 exige poder volver a mostrarlo vía
  // GET /me/entry, imposible con un hash de una sola vía. Aleatorio de
  // alta entropía igual (generateOpaqueToken()).
  entryCode          String    @unique @map("entry_code")
  entryUsedAt        DateTime? @map("entry_used_at") @db.Timestamptz
  entryValidatedById String?   @map("entry_validated_by") @db.Uuid
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  revokedById        String?   @map("revoked_by") @db.Uuid
  revokedReason      String?   @map("revoked_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event            Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  run              SelectionRun?   @relation(fields: [runId, eventId], references: [id, eventId], onDelete: Restrict)
  student          StudentProfile? @relation(fields: [studentId], references: [userId])
  assignedBy       User?           @relation("SelectionAssignedBy", fields: [assignedById], references: [id])
  entryValidatedBy User?           @relation("SelectionEntryValidatedBy", fields: [entryValidatedById], references: [id])
  revokedBy        User?           @relation("SelectionRevokedBy", fields: [revokedById], references: [id])

  @@index([eventId, revokedAt, createdAt(sort: Desc)])
  @@index([runId])
  @@index([studentId])
  @@map("selections")
}
