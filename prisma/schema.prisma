generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Nota de diseño: se intentó citext (Unsupported("citext")) para email
// insensible a mayúsculas, pero Prisma EXCLUYE por completo los campos
// Unsupported de su API tipada (create/findUnique/where no pueden tocarlos
// -- confirmado inspeccionando el cliente generado, no solo @unique falla).
// Se usa TEXT normal + CHECK (email = lower(email)) + UNIQUE: el motor
// rechaza cualquier fila que no llegue ya en minúsculas, y la app normaliza
// siempre antes de escribir/consultar (src/common/utils/normalize-email.util.ts).
model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  fullName           String   @map("full_name")
  status             String   @default("PENDING")
  registrationSource String   @map("registration_source")
  createdById        String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz

  createdBy      User?          @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]         @relation("UserCreatedBy")
  roles          UserRole[]     @relation("UserRoles")
  grantedRoles   UserRole[]     @relation("RoleGrantedBy")
  authTokens     AuthToken[]    @relation("AuthTokenUser")
  createdTokens  AuthToken[]    @relation("AuthTokenCreatedBy")
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  studentProfile StudentProfile?
  resolvedCorrectionRequests CorrectionRequest[] @relation("CorrectionRequestResolvedBy")
  updatedEvents              Event[]
  updatedContentBlocks       ContentBlock[]

  @@map("users")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  role       String
  grantedById String? @map("granted_by") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model AuthToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  tokenHash   String    @unique @map("token_hash")
  newEmail    String?   @map("new_email")
  createdById String?   @map("created_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User  @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AuthTokenCreatedBy", fields: [createdById], references: [id])

  @@map("auth_tokens")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id") @db.Uuid
  replacedById String?  @unique @map("replaced_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenChain")

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  careers Career[]

  @@map("faculties")
}

model Career {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  faculty         Faculty          @relation(fields: [facultyId], references: [id])
  studentProfiles StudentProfile[]

  @@unique([facultyId, name])
  @@map("careers")
}

// 1:1 real con User: la propia FK es la PK (mismo patrón que ya usa 003 al
// referenciar student_profiles(user_id)). total_points NO se declara aquí:
// lo agrega 003-motor-de-puntos por ALTER TABLE.
model StudentProfile {
  userId              String    @id @map("user_id") @db.Uuid
  studentCode         String    @unique @map("student_code")
  careerId            String    @map("career_id") @db.Uuid
  academicPeriod      String    @map("academic_period")
  phone               String
  avatarUrl           String?   @map("avatar_url")
  idDocumentUrl       String?   @map("id_document_url")
  bio                 String?
  interests           String[]
  accessibilityNeeds  String?   @map("accessibility_needs")
  professionalLink    String?   @map("professional_link")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  user                User                @relation(fields: [userId], references: [id])
  career              Career              @relation(fields: [careerId], references: [id])
  consentAcceptances  ConsentAcceptance[]
  correctionRequests  CorrectionRequest[]

  @@map("student_profiles")
}

// El texto es configurable por el admin (RF-128) -- todavía no existe un
// texto legal aprobado por la universidad, así que no puede ser fijo en el
// código. Solo una versión activa a la vez (índice único parcial en la
// migración).
model ConsentVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version   String   @unique
  body      String
  isActive  Boolean  @default(true) @map("is_active")
  createdById String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  acceptances ConsentAcceptance[]

  @@map("consent_versions")
}

model ConsentAcceptance {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  consentVersionId  String   @map("consent_version_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  student        StudentProfile @relation(fields: [studentId], references: [userId])
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id])

  @@unique([studentId, consentVersionId])
  @@map("consent_acceptances")
}

// No estaba en data-model.md de 001-a (vacío ahí) -- lo exige el contrato
// usuarios-y-roles.md (POST /me/correction-requests, GET/POST resolve).
// Diseñado ahora, documentado como desvío en docs/progress.md.
model CorrectionRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  field          String
  newValue       String    @map("new_value")
  reason         String
  status         String    @default("PENDING")
  resolvedById   String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  student    StudentProfile @relation(fields: [studentId], references: [userId])
  resolvedBy User?          @relation("CorrectionRequestResolvedBy", fields: [resolvedById], references: [id])

  @@map("correction_requests")
}

// Singleton operativo: solo una fila PUBLISHED a la vez (índice único
// parcial en la migración, one_published_event). Sin historial de
// ediciones a propósito -- el spec solo pide editar el evento actual, no
// gestionar varias ediciones (Artículo VII, ver plan.md de 002).
model Event {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  tagline     String?
  startsAt    DateTime @map("starts_at") @db.Timestamptz
  venue       String?
  capacity    Int?
  imageUrl    String?  @map("image_url")
  status      String   @default("DRAFT")
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("events")
}

// Clave -> texto editable por el admin sin desplegar código (RF-203). Sin
// versionado ni estado de publicación -- no hay aquí el requisito legal que
// justifica el versionado de ConsentVersion (ver plan.md de 002).
model ContentBlock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  title       String?
  body        String
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("content_blocks")
}
